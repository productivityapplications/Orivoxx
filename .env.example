# Server-side only — never prefix secrets with NEXT_PUBLIC_

# Featured model provider: OpenRouter (OpenAI-compatible API).
# The app also supports any OpenAI-compatible endpoint through these variables.
MODEL_PROVIDER=openrouter
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
# Alias supported for convenience: OPENROUTER_API_KEY
OPENROUTER_API_KEY=
MODEL_NAME=openai/gpt-4o-mini
FALLBACK_MODEL_NAME=deepseek/deepseek-chat-v3-0324
DEMO_SECOND_MODEL=deepseek/deepseek-chat-v3-0324
HEAD_TO_HEAD_MODEL=deepseek/deepseek-v3.2

# Optional demoted legacy provider. Not required and not featured.
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL_ID=nvidia/Nemotron-3.5-Super-VL

# Shared leaderboard store and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin and environment.
APP_BASE_URL=http://localhost:3000
ORIVOXX_ENV=development
ORIVOXX_DATA_DIR=.data/results
ORIVOXX_ORGANIZER_TOKEN=

# Demo-video only (build machine, not the deployed app).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional safe overrides; hardcoded security ceilings must remain in code.
ORIVOXX_MAX_ARCHIVE_BYTES=3145728
ORIVOXX_MAX_SOURCE_BYTES=2097152
