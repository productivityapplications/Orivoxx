{
  "name": "orivoxx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "smoke": "pnpm --filter web smoke",
    "bench:list": "node --env-file-if-exists=.env.local packages/harness/scripts/run-benchmark.mjs --list",
    "bench:run": "node --env-file-if-exists=.env.local packages/harness/scripts/run-benchmark.mjs",
    "bench:publish": "node --env-file-if-exists=.env.local packages/harness/scripts/publish-results.mjs",
    "test:e2e": "playwright test",
    "bench:real": "node --env-file-if-exists=.env.local packages/harness/scripts/run-real-task.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
